---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: postgres-data
  namespace: {{ hypermnesia_namespace }}
  labels: {app.kubernetes.io/name: postgres, app.kubernetes.io/part-of: hypermnesia}
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: {{ hypermnesia_storage_class }}
  resources:
    requests: {storage: {{ hypermnesia_postgres_storage }}}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: postgres
  namespace: {{ hypermnesia_namespace }}
  labels: {app.kubernetes.io/name: postgres, app.kubernetes.io/part-of: hypermnesia}
spec:
  replicas: 1
  strategy: {type: Recreate}
  selector:
    matchLabels: {app.kubernetes.io/name: postgres}
  template:
    metadata:
      labels: {app.kubernetes.io/name: postgres, app.kubernetes.io/part-of: hypermnesia}
    spec:
      securityContext: {runAsNonRoot: true, fsGroup: 999}
      containers:
        - name: postgres
          image: {{ hypermnesia_postgres_image }}
          imagePullPolicy: IfNotPresent
          envFrom:
            - secretRef: {name: {{ hypermnesia_postgres_existing_secret }}}
          ports: [{name: postgres, containerPort: 5432}]
          readinessProbe:
            exec: {command: [pg_isready, -U, {{ hypermnesia_postgres_user }}, -d, {{ hypermnesia_postgres_database }}]}
            initialDelaySeconds: 5
            periodSeconds: 5
          resources:
            requests: {cpu: 250m, memory: 512Mi}
            limits: {memory: 2Gi}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL]}
          volumeMounts: [{name: data, mountPath: /var/lib/postgresql/data}]
      volumes:
        - name: data
          persistentVolumeClaim: {claimName: postgres-data}
---
apiVersion: v1
kind: Service
metadata:
  name: postgres
  namespace: {{ hypermnesia_namespace }}
  labels: {app.kubernetes.io/name: postgres, app.kubernetes.io/part-of: hypermnesia}
spec:
  type: ClusterIP
  selector: {app.kubernetes.io/name: postgres}
  ports: [{name: postgres, port: 5432, targetPort: postgres}]
{% if hypermnesia_tei_enabled %}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: tei-cache
  namespace: {{ hypermnesia_namespace }}
  labels: {app.kubernetes.io/name: tei, app.kubernetes.io/part-of: hypermnesia}
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: {{ hypermnesia_storage_class }}
  resources:
    requests: {storage: {{ hypermnesia_tei_storage }}}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: tei
  namespace: {{ hypermnesia_namespace }}
  labels: {app.kubernetes.io/name: tei, app.kubernetes.io/part-of: hypermnesia}
spec:
  replicas: 1
  strategy: {type: Recreate}
  selector:
    matchLabels: {app.kubernetes.io/name: tei}
  template:
    metadata:
      labels: {app.kubernetes.io/name: tei, app.kubernetes.io/part-of: hypermnesia}
    spec:
      securityContext: {runAsNonRoot: true, seccompProfile: {type: RuntimeDefault}}
      containers:
        - name: tei
          image: {{ hypermnesia_tei_image }}
          args: [--model-id, {{ hypermnesia_tei_model }}, --port, "8080"]
          ports: [{name: http, containerPort: 8080}]
          readinessProbe: {httpGet: {path: /health, port: http}, initialDelaySeconds: 10, periodSeconds: 10}
          resources:
            requests: {cpu: "1", memory: {{ hypermnesia_tei_memory_request }}}
            limits: {memory: {{ hypermnesia_tei_memory_limit }}}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL]}
          volumeMounts: [{name: cache, mountPath: /data}]
      volumes:
        - name: cache
          persistentVolumeClaim: {claimName: tei-cache}
---
apiVersion: v1
kind: Service
metadata:
  name: tei
  namespace: {{ hypermnesia_namespace }}
spec:
  type: ClusterIP
  selector: {app.kubernetes.io/name: tei}
  ports: [{name: http, port: 8080, targetPort: http}]
{% endif %}
{% if hypermnesia_reranker_enabled %}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: reranker
  namespace: {{ hypermnesia_namespace }}
spec:
  replicas: 1
  selector: {matchLabels: {app.kubernetes.io/name: reranker}}
  template:
    metadata: {labels: {app.kubernetes.io/name: reranker, app.kubernetes.io/part-of: hypermnesia}}
    spec:
      containers:
        - name: reranker
          image: {{ hypermnesia_reranker_image }}
          ports: [{name: http, containerPort: 8091}]
          readinessProbe: {httpGet: {path: /health, port: http}, initialDelaySeconds: 10, periodSeconds: 10}
          resources: {requests: {cpu: 250m, memory: 512Mi}, limits: {memory: 2Gi}}
          securityContext: {allowPrivilegeEscalation: false, capabilities: {drop: [ALL]}}
---
apiVersion: v1
kind: Service
metadata: {name: reranker, namespace: {{ hypermnesia_namespace }}}
spec:
  type: ClusterIP
  selector: {app.kubernetes.io/name: reranker}
  ports: [{name: http, port: 8091, targetPort: http}]
{% endif %}
{% if hypermnesia_vllm_enabled %}
---
apiVersion: apps/v1
kind: Deployment
metadata: {name: vllm, namespace: {{ hypermnesia_namespace }}}
spec:
  replicas: 1
  selector: {matchLabels: {app.kubernetes.io/name: vllm}}
  template:
    metadata: {labels: {app.kubernetes.io/name: vllm, app.kubernetes.io/part-of: hypermnesia}}
    spec:
      containers:
        - name: vllm
          image: {{ hypermnesia_vllm_image }}
          args: [--model, {{ hypermnesia_vllm_model }}, --host, 0.0.0.0, --port, "8000"]
          ports: [{name: http, containerPort: 8000}]
          readinessProbe: {httpGet: {path: /health, port: http}, initialDelaySeconds: 30, periodSeconds: 10}
          envFrom: [{secretRef: {name: {{ hypermnesia_vllm_existing_secret }}, optional: true}}]
          resources: {{ hypermnesia_vllm_resources | to_json }}
          securityContext: {allowPrivilegeEscalation: false, capabilities: {drop: [ALL]}}
---
apiVersion: v1
kind: Service
metadata: {name: vllm, namespace: {{ hypermnesia_namespace }}}
spec:
  type: ClusterIP
  selector: {app.kubernetes.io/name: vllm}
  ports: [{name: http, port: 8000, targetPort: http}]
{% endif %}
{% for job in hypermnesia_memory_cronjobs %}
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: {{ job.name }}
  namespace: {{ hypermnesia_namespace }}
spec:
  schedule: {{ job.schedule | to_json }}
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 1
  failedJobsHistoryLimit: 2
  jobTemplate:
    spec:
      template:
        metadata: {labels: {app.kubernetes.io/part-of: hypermnesia, hypermnesia.io/database-client: "true", hypermnesia.io/model-client: "true"}}
        spec:
          restartPolicy: Never
          containers:
            - name: worker
              image: {{ hypermnesia_worker_image }}
              args: {{ job.args | to_json }}
              envFrom: [{secretRef: {name: {{ hypermnesia_migration_existing_secret }}}}]
              resources: {{ job.resources | default({'requests': {'cpu': '100m', 'memory': '256Mi'}, 'limits': {'memory': '1Gi'}}) | to_json }}
              securityContext: {allowPrivilegeEscalation: false, capabilities: {drop: [ALL]}}
{% endfor %}
{% if hypermnesia_network_policies_enabled %}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: postgres-clients, namespace: {{ hypermnesia_namespace }}}
spec:
  podSelector: {matchLabels: {app.kubernetes.io/name: postgres}}
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector: {matchLabels: {hypermnesia.io/database-client: "true"}}
      ports: [{protocol: TCP, port: 5432}]
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata: {name: model-clients, namespace: {{ hypermnesia_namespace }}}
spec:
  podSelector:
    matchExpressions:
      - {key: app.kubernetes.io/name, operator: In, values: [tei, reranker, vllm]}
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector: {matchLabels: {hypermnesia.io/model-client: "true"}}
{% endif %}
