# Copy to .env next to docker-compose.yml, then `docker compose up -d`.
# Compose refuses to start without POSTGRES_PASSWORD, so this file is not optional.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=hm
POSTGRES_DB=hypermnesia
# No default on purpose. Generate one, don't invent one:
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Host port for Postgres. 5432 collides with a Postgres already running on the
# box -- if `docker compose up` reports the port is in use, move this, don't
# stop the other one.
PG_PORT=5432

# --- Embedder (TEI) ---------------------------------------------------------
TEI_PORT=8080
# CPU threads for the embedder. It is the greediest thing in the stack: a bulk
# embed will take everything you give it and starve interactive queries on the
# same box, so keep this well under your core count.
TEI_THREADS=4

# --- Reranker (only with `--profile rerank`) --------------------------------
RERANK_PORT=8091
# Seconds idle before the model is unloaded (~3.4GB resident -> ~150MB).
# 0 keeps it resident.
RERANK_IDLE_SEC=600

# --- What the client tools read ---------------------------------------------
# Not used by compose; export these in your shell (or your MCP client's env) so
# ingest, search and the hooks reach the stack above.
#   DATABASE_URL=postgresql://hm:<the password above>@localhost:5432/hypermnesia
#   EMBED_BACKEND=tei
#   TEI_URL=http://localhost:8080
